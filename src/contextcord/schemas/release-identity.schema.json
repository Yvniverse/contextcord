{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-harness.dev/schemas/release-identity.schema.json",
  "title": "Unified Project Harness ReleaseIdentity",
  "type": "object",
  "required": ["schema", "source_identity", "groups", "runtime", "status", "release_sha256"],
  "properties": {
    "schema": {"const": "project-harness-release-identity-v1"},
    "source_identity": {"type": "object"},
    "groups": {"type": "object"},
    "runtime": {"type": "object"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "release_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
