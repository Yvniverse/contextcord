  "cards": [
    {
      "dot": "emerald",
      "title": "Four data classes stay separated",
      "items": [
        "Source identity and execution evidence remain repository-local.",
        "Task context, external priors, and Jev projections each have a bounded data path."
      ]
    },
    {
      "dot": "violet",
      "title": "Analysis data does not grant execution",
      "items": [
        "CodexRadar provides derived priors only; it cannot make a route executable.",
        "The Execution Catalog and host permissions remain code-owned."
      ]
    },
    {
      "dot": "amber",
      "title": "Learning consumes real outcomes only",
      "items": [
        "Only real executions checked by the Verifier enter the Local Outcome Ledger.",
        "Fixture and shadow recommendations remain analysis evidence, never outcomes."
      ]
    }
  ]
