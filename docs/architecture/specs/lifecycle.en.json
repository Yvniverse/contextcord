  "cards": [
    {
      "dot": "emerald",
      "title": "HANDOFF and COMPLETE are distinct",
      "items": [
        "HANDOFF is a resumable non-terminal boundary; a later resume opens a new Session.",
        "COMPLETE requires current source, tests, and evidence to satisfy the completion contract."
      ]
    },
    {
      "dot": "violet",
      "title": "Semantic judgment stays inside Route Decision",
      "items": [
        "Gate 0 requests Jev only when the tradeoff needs semantic judgment.",
        "If Jev is unavailable, routing falls back to the deterministic planner without changing authority."
      ]
    },
    {
      "dot": "amber",
      "title": "Failure paths stay bounded",
      "items": [
        "An execution failure allows at most one automatic escalation before routing is reconsidered.",
        "When no executable route exists, enter BLOCKED rather than fabricating model execution."
      ]
    }
  ]
