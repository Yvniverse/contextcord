{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://project-harness.dev/schemas/runner-receipt.schema.json",
  "title":"Unified Project Harness runner receipt",
  "type":"object",
  "required":["schema","name","session_id","task_id","command","command_display","cwd","started_at","finished_at","duration_seconds","status","source_identity_sha256","log_path","output_control"],
  "properties":{"schema":{"const":"project-harness-runner-receipt-v1"},"name":{"type":"string"},"session_id":{"type":"string"},"task_id":{"type":"string"},"command":{"type":"array","minItems":1,"items":{"type":"string"}},"command_display":{"type":"string"},"cwd":{"type":"string"},"started_at":{"type":"string"},"finished_at":{"type":"string"},"duration_seconds":{"type":"number","minimum":0},"exit_code":{"type":["integer","null"]},"status":{"enum":["PASS","FAIL","BLOCKED"]},"reason":{"type":["string","null"]},"source_identity_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"log_path":{"type":"string"},"output_control":{"type":"object"}},
  "additionalProperties":true
}
